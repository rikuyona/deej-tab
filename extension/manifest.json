{
  "manifest_version": 3,
  "name": "deej タブ音量",
  "version": "1.3.1",
  "description": "deej-tab の物理スライダーで、Chrome のタブごとの音量を操作します",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "tabCapture",
    "offscreen",
    "activeTab",
    "alarms",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "deej タブ音量",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "ポップアップを開く"
    },
    "slot-next": {
      "description": "このタブを空いている番号に割り当てる (押すたびに次の番号へ移り、最後は解除)",
      "suggested_key": {
        "default": "Alt+Shift+A"
      }
    },
    "slot-1": {
      "description": "このタブをタブ 1 に割り当てる (もう一度押すと解除)",
      "suggested_key": {
        "default": "Alt+Shift+1"
      }
    },
    "slot-2": {
      "description": "このタブをタブ 2 に割り当てる (もう一度押すと解除)",
      "suggested_key": {
        "default": "Alt+Shift+2"
      }
    },
    "slot-3": {
      "description": "このタブをタブ 3 に割り当てる (もう一度押すと解除)"
    },
    "slot-4": {
      "description": "このタブをタブ 4 に割り当てる (もう一度押すと解除)"
    },
    "slot-5": {
      "description": "このタブをタブ 5 に割り当てる (もう一度押すと解除)"
    },
    "slot-6": {
      "description": "このタブをタブ 6 に割り当てる (もう一度押すと解除)"
    }
  }
}
